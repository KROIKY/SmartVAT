<Window x:Class="SmartVAT.WPF.AdaugaFurnizorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adaugă Furnizor Nou" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F9" Foreground="#333333"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B5998"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Padding" Value="0,0,0,3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        
        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#D1D9E6" Opacity="0.5"/>
    </Window.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="Auto"/> <!-- Identificare -->
            <RowDefinition Height="Auto"/> <!-- Eroare -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="Adăugare Furnizor Intracomunitar" FontSize="22" FontWeight="Bold" Foreground="#222" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <!-- Date Identificare -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,15" Effect="{StaticResource CardShadow}">
            <StackPanel>
                <TextBlock Text="DATE FURNIZOR (Extras Factură)" Foreground="#888888" FontSize="11" Margin="0,0,0,10" FontWeight="Bold"/>

                <Label x:Name="lbCUIFurnizor" Content="Cod TVA (Ex: ATU38.. / DE48..)"/>
                <TextBox x:Name="tbCUIFurnizor" Style="{StaticResource InputTextBoxStyle}"/>
                
                <Label x:Name="lbDenumireFurnizor" Content="Denumire Companie Furnizor"/>
                <TextBox x:Name="tbDenumireFurnizor" Style="{StaticResource InputTextBoxStyle}"/>

                <Label x:Name="lbAdresaFurnizor" Content="Adresa Completă (Sediul social)"/>
                <TextBox x:Name="tbAdresaFurnizor" Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,5"/>
            </StackPanel>
        </Border>

        <!-- Mesaj Eroare -->
        <TextBlock x:Name="lbEroare" Grid.Row="2" Text="Eroare afisata aici" Foreground="#D8000C" FontWeight="SemiBold" Visibility="Hidden" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <!-- Botoane -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0">
            <Button x:Name="btnAnuleaza" Content="Anulează" Width="100" Margin="0,0,10,0" Background="#DDDDDD" Foreground="#555555" Style="{StaticResource ActionBtnStyle}" Click="btnAnuleaza_Click"/>
            <Button x:Name="btnAdauga" Content="Salvează Furnizorul" Width="140" Style="{StaticResource ActionBtnStyle}" Click="btnAdauga_Click"/>
        </StackPanel>
    </Grid>
</Window>
