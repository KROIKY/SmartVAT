<Window x:Class="SmartVAT.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartVAT.WPF"
        mc:Ignorable="d"
        Title="SmartVAT - Dashboard" Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bara laterală / Lista -->
        <Border Grid.Column="0" Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Firme Înregistrate" FontWeight="Bold" FontSize="20" Margin="20,20,20,10" Foreground="#007ACC" />

                <!-- Lista de firme legate (Binding) -->
                <ListBox x:Name="lbFirme" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Foreground="White" SelectionChanged="lbFirme_SelectionChanged"
                         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         DisplayMemberPath="Denumire">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="15,10" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Border" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="true" CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="true"/>
                                                    <Condition Property="IsSelected" Value="true"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Border" Property="Background" Value="#007ACC"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button x:Name="btnAddFirma" Content="+ Adaugă Firmă Test" Grid.Row="2" Margin="20" 
                        Height="40" Background="#007ACC" Foreground="White" BorderThickness="0"
                        Click="btnAddFirma_Click" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Panoul de Detalii -->
        <Border Grid.Column="1" Padding="40" Background="#1E1E1E">
            <Grid x:Name="gridDetalii" Visibility="Hidden">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Profilul Companiei" FontSize="26" FontWeight="Light" Margin="0,0,0,30" Foreground="#007ACC"/>

                <Border Grid.Row="1" Background="#252526" CornerRadius="8" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0 -->
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="DENUMIRE COMPANIE" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtNume" Text="-" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,20"/>

                            <TextBlock Text="C.U.I. (COD UNIC ÎNREGISTRARE)" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCUI" Text="-" FontSize="16" Margin="0,0,0,20"/>

                            <TextBlock Text="DOMICILIU FISCAL" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtAdresa" Text="-" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,20"/>
                        </StackPanel>

                        <!-- Col 1 -->
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="CONT IBAN" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtIBAN" Text="-" FontSize="16" Margin="0,0,0,20" FontFamily="Consolas" Foreground="#4EC9B0"/>

                            <TextBlock Text="BANCĂ (SWIFT)" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtSwift" Text="-" FontSize="16" Margin="0,0,0,20"/>

                            <TextBlock Text="COD CAEN" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtCAEN" Text="-" FontSize="16" Margin="0,0,0,20"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#252526" CornerRadius="8" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TELEFON CONTABIL" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtTelContabil" Text="-" FontSize="16"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="EMAIL CONTABIL" Foreground="#888888" FontSize="11" Margin="0,0,0,5" FontWeight="Bold"/>
                            <TextBlock x:Name="txtEmailContabil" Text="-" FontSize="16" Foreground="#569CD6"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
