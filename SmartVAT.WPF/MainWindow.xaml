<Window x:Class="SmartVAT.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartVAT - Dashboard" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9" Foreground="#333333"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Bara Laterală (Dark Theme) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A0AABF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D4B66"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Buton Acțiune Principal (Albastru Admistory) -->
        <Style x:Key="PrimaryActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B5998"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2D4373"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Stil DataGrid Minimalist -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E6ED"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="45"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#999999"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E6ED"/>
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F0F5FF"/>
                    <Setter Property="Foreground" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#D1D9E6" Opacity="0.5"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bara Laterală -->
        <Border Grid.Column="0" Background="#2B3648">
            <StackPanel Margin="0,30,0,0">
                <TextBlock Text="SmartVAT" FontSize="26" FontWeight="Black" Foreground="White" Margin="25,0,0,40" />

                <!-- Meniu Navigatie legat de ICommand din ViewModel -->
                <Button Content="📄 Dosare Rambursare" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavDosareCommand}"/>
                <Button Content="🏢 Firme" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavFirmeCommand}"/>
                <Button Content="🛒 Furnizori" Style="{StaticResource SidebarButtonStyle}" Command="{Binding NavFurnizoriCommand}"/>
            </StackPanel>
        </Border>

        <!-- Conținut Principal -->
        <Border Grid.Column="1" Padding="40" Background="#F4F6F9">
            <Grid>
                <!-- ============================ -->
                <!-- PANOU FIRME                  -->
                <!-- ============================ -->
                <Grid x:Name="gridFirme" Visibility="{Binding VisFirme}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="Auto"/> 
                        <RowDefinition Height="*"/>    
                        <RowDefinition Height="Auto"/> <!-- Edit form -->
                    </Grid.RowDefinitions>

                    <!-- Titlu si Buton Adaugare -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Firme" FontSize="24" FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Total:" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FirmeView.Count}" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="Blue"/>
                            <Button Content="+ ADAUGĂ FIRMĂ" Style="{StaticResource PrimaryActionBtnStyle}" Command="{Binding AdaugaFirmaPopupCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bara de Search -->
                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,20" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" Foreground="#BBBBBB" FontSize="16" Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Width="300" FontSize="14" Foreground="#333" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" 
                                     Text="{Binding SearchFirmeText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <!-- Tabel Firme -->
                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0,10" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <DataGrid ItemsSource="{Binding FirmeView}" SelectedItem="{Binding SelectedFirma}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="150">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding DisplayId}" Width="50"/>
                                    <DataGridTextColumn Header="CUI" Binding="{Binding CUI}" Width="150"/>
                                    <DataGridTextColumn Header="DENUMIRE COMPANIE" Binding="{Binding Denumire}" Width="*"/>
                                    
                                    <DataGridTemplateColumn Header="Acțiuni" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="ℹ️ Info" Padding="5,2" Margin="0,0,5,0" 
                                                            Command="{Binding DataContext.InfoFirmaCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="✏️ Edit" Padding="5,2" 
                                                            Command="{Binding DataContext.ModificaFirmaCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================ -->
                <!-- PANOU FURNIZORI              -->
                <!-- ============================ -->
                <Grid x:Name="gridFurnizori" Visibility="{Binding VisFurnizori}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/> <!-- Edit form -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Furnizori" FontSize="24" FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Total:" Margin="0,0,5,0" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FurnizoriView.Count}" Margin="0,0,20,0" VerticalAlignment="Center" Foreground="Blue"/>
                            <Button Content="+ ADAUGĂ FURNIZOR" Style="{StaticResource PrimaryActionBtnStyle}" Command="{Binding AdaugaFurnizorPopupCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,20" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" Foreground="#BBBBBB" FontSize="16" Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Width="300" FontSize="14" Foreground="#333" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" 
                                     Text="{Binding SearchFurnizoriText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0,10" Effect="{StaticResource CardShadow}">
                        <DataGrid ItemsSource="{Binding FurnizoriView}" SelectedItem="{Binding SelectedFurnizor}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CUI FURNIZOR" Binding="{Binding CuloareTVA_CIF}" Width="150"/>
                                <DataGridTextColumn Header="DENUMIRE COMPANIE" Binding="{Binding Denumire}" Width="250"/>
                                <DataGridTextColumn Header="ADRESĂ FACTURARE" Binding="{Binding Adresa}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- EDIT FURNIZOR SECTION -->
                    <Border Grid.Row="3" Background="#E9EDF5" Padding="20" Margin="0,20,0,0" CornerRadius="8" Visibility="{Binding VisEditFurnizor}">
                        <StackPanel DataContext="{Binding SelectedFurnizor}">
                            <TextBlock Text="Modificare Furnizor Selectat:" FontWeight="Bold" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Margin="0,0,15,10">
                                    <TextBlock Text="CUI FURNIZOR:"/>
                                    <TextBox Text="{Binding CuloareTVA_CIF, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,15,10">
                                    <TextBlock Text="Denumire:"/>
                                    <TextBox Text="{Binding Denumire, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="5"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,15,10">
                                    <TextBlock Text="Adresa:"/>
                                    <TextBox Text="{Binding Adresa, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="5"/>
                                </StackPanel>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Șterge Furnizor" Style="{StaticResource PrimaryActionBtnStyle}" Background="DarkRed" Command="{Binding DataContext.StergeFurnizorCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0"/>
                                <Button Content="Salvează Modificările" Style="{StaticResource PrimaryActionBtnStyle}" Command="{Binding DataContext.ActualizeazaFurnizorCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ============================ -->
                <!-- PANOU DOSARE                 -->
                <!-- ============================ -->
                <Grid x:Name="gridDosare" Visibility="{Binding VisDosare}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Cererile de Recuperare TVA (D318)" FontSize="24" FontWeight="Bold" Foreground="#222222" VerticalAlignment="Center"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🗑️ Golește Baza" Style="{StaticResource PrimaryActionBtnStyle}" Background="DarkRed" Margin="0,0,10,0" Command="{Binding ClearDosareCommand}"/>
                            <Button Content="📂 Încarcă Excel" Style="{StaticResource PrimaryActionBtnStyle}" Command="{Binding ImportExcelCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15,10" Margin="0,0,0,20" Effect="{StaticResource CardShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Alege Firma Solicitantă:" Foreground="#555" FontWeight="SemiBold" Margin="10,0,10,0" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding Firme}" SelectedItem="{Binding FirmaSelectataPentruDosar}" DisplayMemberPath="Denumire" Width="300" Padding="5" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="0,10" Effect="{StaticResource CardShadow}">
                        <Grid>
                            <DataGrid ItemsSource="{Binding GrupuriCereri}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="150" Margin="0,0,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ȚARA" Binding="{Binding Tara}" Width="80" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Nr. Facturi" Binding="{Binding NumarFacturi}" Width="100"/>
                                    <DataGridTextColumn Header="Total TVA (Moneda Țării)" Binding="{Binding TotalTvaDeductibil}" Width="200"/>
                                    
                                    <DataGridTemplateColumn Header="Acțiuni" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="🔍 Vezi Facturi" Padding="8,4" Margin="0,0,10,0"
                                                            Command="{Binding DataContext.VeziFacturiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="📄 Generează Cerere D318" Padding="8,4" Background="MediumSeaGreen" Foreground="White"
                                                            Command="{Binding DataContext.GenereazaCerereCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <TextBlock Text="Nu există date încărcate. Apăsați 'Încarcă Excel'." Foreground="#888" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GrupuriCereri.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
